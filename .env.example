# Copy this to .env (which git ignores) and fill it in. Never commit .env.

# From Google Cloud Console → Google Auth Platform → Clients (type: Web application).
# Its authorized redirect URI must be: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only change these when the API or web app run somewhere else.
# OSCAR_API_URL=http://localhost:8000
# OSCAR_WEB_URL=http://localhost:3000

# Optional: a Gemini key, for the chat, for reading emails the rules don't recognise
# (OSCAR_MODEL_READS below) and for reply drafts. Without it, Oscar uses his basic chat,
# the rules alone, and writes no drafts. The evals don't need it: they use the readings
# saved in evals/cache. A free key comes from https://aistudio.google.com/apikey. On the
# free tier Google may use what's sent to improve its products.
GEMINI_API_KEY=
# OSCAR_CHAT_MODEL=gemini-flash-latest

# How often Oscar checks Gmail on his own while the API runs, in minutes (0 = never).
# OSCAR_AUTO_CHECK_MINUTES=5

# Stage 11: let the model read your real emails, so Oscar understands the ones his rules
# don't recognise. off (default): never. preview: sender, subject and the first few lines.
# full: the whole email. Only turn on full with a paid key: on the free tier Google may use
# what's sent. Answers are saved in your account's data folder, never in the repo.
# OSCAR_MODEL_READS=off
# OSCAR_MODEL=gemini-flash-latest
