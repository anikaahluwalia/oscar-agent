{
  "manifest_version": 3,
  "name": "Oscar for Gmail",
  "version": "0.1.0",
  "description": "Oscar peeks out from the corner of Gmail: what needs you, and his call on the email you have open.",
  "icons": {"16": "icons/oscar-16.png", "32": "icons/oscar-32.png", "48": "icons/oscar-48.png", "128": "icons/oscar-128.png"},
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "web_accessible_resources": [{"resources": ["moods/*.webp", "icons/*.png"], "matches": ["https://mail.google.com/*"]}],
  "options_page": "options.html"
}
